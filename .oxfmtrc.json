{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "es5",
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "printWidth": 80,
  "experimentalSortPackageJson": false,
  "ignorePatterns": ["**/generated/**", "**/__generated__/**"],
  "sortImports": true
}
