{
  "name": "root",
  "private": true,
  "engines": {
    "bun": "1.4.0",
    "node": "24.18.0"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "dev": "bun run scripts/dev.ts",
    "dev:packages": "lerna run dev --scope=@altertable/altertable-* --parallel",
    "dev:examples": "lerna run dev --scope=@altertable/example-* --parallel",
    "clean": "lerna run clean",
    "typecheck": "lerna run typecheck",
    "lint": "oxlint --type-aware --deny-warnings . && oxfmt --check .",
    "lint:fix": "oxlint --type-aware --fix . && oxfmt .",
    "test": "lerna run test",
    "test:watch": "lerna run test:watch --parallel",
    "coverage": "lerna run coverage --parallel",
    "bundlesize": "bundlesize",
    "test:integration": "vitest run --config scripts/integration/vitest.config.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "4.1.11",
    "bundlesize": "0.18.2",
    "jsdom": "27.2.0",
    "lerna": "10.0.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "ts-node": "10.9.2",
    "tslib": "2.8.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "resolutions": {
    "esbuild": "0.25.4",
    "brace-expansion": "2.0.2"
  }
}
