{
  "name": "root",
  "private": true,
  "engines": {
    "bun": "1.4.3",
    "node": "24.18.0"
  },
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev": "bun run build && bun run --parallel --filter '*' dev",
    "dev:packages": "bun run --parallel --filter './packages/*' dev",
    "dev:examples": "bun run --parallel --filter './examples/*' dev",
    "clean": "bun run --filter '*' clean",
    "typecheck": "tsc --noEmit && bun run --filter '*' typecheck",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --fix .",
    "test": "bun run --filter './packages/*' test",
    "test:watch": "bun run --parallel --filter './packages/*' test:watch",
    "coverage": "bun run --parallel --filter './packages/*' coverage",
    "bundlesize": "bun run scripts/package/check-size.ts",
    "check:react-native": "bun run scripts/react-native/check-runtime.ts",
    "test:integration": "vitest run --config scripts/integration/vitest.config.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run build && bun run typecheck && bun run lint && bun run knip && bun run format:check && bun run test && bun run check:package",
    "check:package": "bun run bundlesize && bun run scripts/package/check-consumer.ts",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "4.1.11",
    "acorn": "8.15.0",
    "jsdom": "27.2.0",
    "knip": "6.32.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "resolutions": {
    "esbuild": "0.25.4",
    "brace-expansion": "2.0.2"
  }
}
