{
  "name": "@altertable/altertable-react",
  "description": "React SDK to capture and send events to Altertable.",
  "version": "1.4.0",
  "license": "MIT",
  "homepage": "https://github.com/altertable-ai/altertable-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altertable-ai/altertable-js.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "author": {
    "name": "Altertable",
    "url": "https://altertable.ai"
  },
  "keywords": [
    "analytics",
    "track",
    "altertable"
  ],
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "module": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "NODE_ENV=development tsdown --watch",
    "build": "NODE_ENV=production tsdown",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^16.14 || ^17.0 || ^18.0 || ^19.0"
  },
  "dependencies": {
    "@altertable/altertable-js": "^1.4.0"
  },
  "devDependencies": {
    "@posthog/react": "1.11.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "posthog-js": "1.438.21",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@testing-library/dom": "10.4.2"
  }
}
