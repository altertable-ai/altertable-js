{
  // Declaration build for altertable-react-native. It sits above the packages because tsdown
  // emits declarations relative to the tsconfig directory, and types from the
  // private shared modules must be inlined into the package's declarations.
  "extends": "./altertable-react-native/tsconfig.json",
  "include": [
    "altertable-react-native/src/**/*",
    "altertable-react-shared/src/**/*",
    "altertable-shared/src/**/*"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
