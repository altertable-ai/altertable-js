{
  // Declaration build. It sits above the packages so tsdown can inline the
  // types of the private shared modules.
  "extends": "./altertable-react-native/tsconfig.json",
  "include": [
    "altertable-react-native/src/**/*",
    "altertable-react-shared/src/**/*",
    "altertable-shared/src/**/*"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
