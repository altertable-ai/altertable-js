{
  "name": "@altertable/altertable-js",
  "description": "JavaScript SDK to capture and send events to Altertable.",
  "version": "1.4.0",
  "license": "MIT",
  "homepage": "https://github.com/altertable-ai/altertable-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altertable-ai/altertable-js.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "author": {
    "name": "Altertable",
    "url": "https://altertable.ai"
  },
  "keywords": [
    "analytics",
    "track",
    "altertable"
  ],
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "module": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "NODE_ENV=production tsdown",
    "dev": "NODE_ENV=development tsdown --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "posthog-js": "1.438.21",
    "posthog-js-minimum": "npm:posthog-js@1.230.0"
  }
}
